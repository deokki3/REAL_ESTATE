# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git에 올라가지 않는다.

NODE_ENV=development
PORT=4000

# MongoDB 접속 문자열. 로컬 mongod 대신 MongoDB Atlas 무료 클러스터(M0) 사용 중 (2026-08-25~).
# Atlas > Connect > Drivers 에서 받은 mongodb+srv:// 문자열에 DB 이름(/realestate)을 직접 추가해야 한다 — 기본으로는 안 붙어 있다.
MONGO_URI=mongodb+srv://<username>:<password>@estate.l97zm1j.mongodb.net/realestate?retryWrites=true&w=majority&appName=estate

# 공공데이터포털 인증키 (아직 미발급 상태면 비워둔다)
# 포털이 Encoding / Decoding 두 종류를 발급한다. API마다 하나만 동작하는 경우가 있어 둘 다 보관한다.
# 계정 단위 일반인증키라 청약홈(odcloud) API에도 같은 값을 그대로 쓴다 — 게이트웨이 자체는 다르므로 URL을 혼동하지 말 것.
DATA_GO_KR_KEY_ENCODED=
DATA_GO_KR_KEY_DECODED=
# ENCODED | DECODED
DATA_GO_KR_KEY_MODE=DECODED

# 청약홈(한국부동산원) 분양정보 조회 API — LH와 게이트웨이가 다르다 (odcloud, apis.data.go.kr 아님)
# 인증키는 위 DATA_GO_KR_KEY_ENCODED 그대로 사용
APPLYHOME_API_BASE_URL=https://api.odcloud.kr/api/ApplyhomeInfoDetailSvc/v1

# POST /api/ingest/lh (온디맨드 수집) 호출 시 헤더 x-admin-key로 넣어야 하는 공유키.
# v1은 회원 인증이 없어서 배포 시 아무나 이 엔드포인트로 API 호출량을 소진 못하게 막는 최소한의 방어.
# 비워두면 그 엔드포인트 자체가 503으로 막힌다. 아무 임의의 긴 문자열이나 넣으면 된다.
ADMIN_INGEST_KEY=
