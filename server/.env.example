# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git에 올라가지 않는다.

NODE_ENV=development
PORT=4000

# MongoDB 접속 문자열
MONGO_URI=mongodb://127.0.0.1:27017/realestate

# 공공데이터포털 인증키 (아직 미발급 상태면 비워둔다)
# 포털이 Encoding / Decoding 두 종류를 발급한다. API마다 하나만 동작하는 경우가 있어 둘 다 보관한다.
DATA_GO_KR_KEY_ENCODED=
DATA_GO_KR_KEY_DECODED=
# ENCODED | DECODED
DATA_GO_KR_KEY_MODE=DECODED
